# Operator settings for `npm run provision` and `npm run fleet`.
# Copy to .env.provision.local (gitignored) and fill in. See docs/PROVISIONING.md.
#
# Shared settings use a PROVISION_ prefix on purpose: the site's own .env
# holds the Whistle Inn's keys, and the scripts must never copy those into a
# new owner's site.

# Vercel: an access token with access to the team, and the team id (team_…).
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Neon: an API key. NEON_ORG_ID only if the key can see more than one org.
NEON_API_KEY=
NEON_ORG_ID=

# Where sites deploy from and how projects are named.
PROVISION_GIT_REPO=journey247/whistle-inn
PROVISION_PROJECT_PREFIX=stay-
PROVISION_NEON_REGION=aws-us-east-1

# Email: the platform's Resend key, and the default sender (its domain must
# be verified in Resend). An owner's own sender can be passed with --from-email.
PROVISION_RESEND_API_KEY=
PROVISION_FROM_EMAIL=

# Stripe: the PLATFORM account's keys. Owners connect their own account in
# the admin panel; until they do, the launch gate keeps checkout paused.
PROVISION_STRIPE_SECRET_KEY=
PROVISION_STRIPE_PUBLISHABLE_KEY=

# Sites `fleet` covers besides the prefixed ones (comma-separated project names).
FLEET_EXTRA_PROJECTS=whistle-inn
