# =============================================================================
# Whistle Inn — Environment Variables
# Copy to .env.local for development. Set the REQUIRED block in Vercel for prod.
# =============================================================================
#
# Every variable below is actually read by the code. If a name isn't here,
# nothing uses it. Grouped by whether the site breaks without it.
#
# =============================================================================


# =============================================================================
# REQUIRED — the site is broken or unsafe without these
# =============================================================================

# --- Database ---------------------------------------------------------------
# Read by prisma/schema.prisma. Postgres (Neon in production).
DATABASE_URL="postgresql://username:password@hostname:5432/database?sslmode=require"

# --- Payments ---------------------------------------------------------------
# Server-side Stripe key. In production the app now HARD-FAILS checkout if this
# is missing or contains "placeholder"/"waiting" — it will no longer fall back
# to a fake checkout session that marks bookings paid without payment.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Verifies webhook signatures on /api/stripe/webhook. Without it, bookings are
# never marked paid and confirmation emails never send.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Client-side Stripe key used by the booking modal to redirect to Checkout.
# If unset, the modal falls back to "pk_test_placeholder" and checkout FAILS.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# --- Admin auth -------------------------------------------------------------
# Signs and verifies admin JWTs. In production the app refuses to start an admin
# session if this is unset or equal to "dev-secret".
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# Gates one-time admin creation at POST /api/admin/auth/create.
# Server-side only — never prefix with NEXT_PUBLIC_.
# Generate with: openssl rand -hex 32
SETUP_KEY=your-setup-key-here

# --- Site URL ---------------------------------------------------------------
# Used to build Stripe redirect URLs, guest cancellation links in emails, and
# admin notification links. Must be the full public origin, no trailing slash.
NEXT_PUBLIC_BASE_URL=https://thewhistleinn.com

# --- Transactional email ----------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key

# The From: address on guest booking confirmations and cancellations.
# IMPORTANT: if unset this falls back to "onboarding@resend.dev" (Resend's
# sandbox sender), which looks untrustworthy to guests and will often land in
# spam. Set this to a verified domain sender before taking real bookings.
RESEND_FROM_EMAIL=noreply@thewhistleinn.com

# --- Cron -------------------------------------------------------------------
# Protects /api/cron/ical-sync from public calls. Vercel Cron automatically
# sends "Authorization: Bearer <CRON_SECRET>". The endpoint returns 500 if this
# is unset, so iCal sync silently stops without it.
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here


# =============================================================================
# RECOMMENDED — features silently degrade without these
# =============================================================================

# Comma-separated list of origins allowed by the CORS middleware.
# If unset, middleware falls back to a placeholder ("https://yourdomain.com")
# and cross-origin requests from the real site are not allowed.
ALLOWED_ORIGINS=https://thewhistleinn.com,https://www.thewhistleinn.com

# Where new-booking / payment / cancellation notifications are sent.
ADMIN_EMAIL=owner@thewhistleinn.com
ADMIN_NAME=Nora
ADMIN_PHONE=+15555555555

# Reply-To on outgoing guest email. Optional but recommended so guest replies
# reach a real inbox rather than bouncing off the no-reply sender.
RESEND_REPLY_TO=hello@thewhistleinn.com

# Base URL used only by the admin password-reset email.
# NOTE: this duplicates NEXT_PUBLIC_BASE_URL — set both to the same value until
# the two are consolidated.
NEXT_PUBLIC_SITE_URL=https://thewhistleinn.com

# From: address used only by the admin password-reset email.
# NOTE: duplicates RESEND_FROM_EMAIL — set both to the same value.
NEXT_PUBLIC_RESEND_FROM_EMAIL=noreply@thewhistleinn.com


# =============================================================================
# OPTIONAL — safe defaults exist
# =============================================================================

# Reported to the client on login. Note: the issued JWT is currently hardcoded
# to 8h regardless of this value.
SESSION_TIMEOUT_HOURS=8

NODE_ENV=development


# =============================================================================
# SCRIPTS ONLY — not read by the app
# =============================================================================

# Used by `npm run create-admin` (scripts/create_admin.js).
# The script defaults to "password123" if unset — always set a real password,
# and change it after first login.
ADMIN_PASSWORD=choose-a-strong-password


# =============================================================================
# SET AUTOMATICALLY BY VERCEL — do not define manually
# =============================================================================
# VERCEL           — presence detected to skip the local iCal sync initializer
